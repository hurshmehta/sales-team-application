# Supabase (required)
# Create a project at https://supabase.com, then copy these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Calendly (optional, defaults to the URL below)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/hurshmehta2/30min

# Admin page password (required for /admin)
# Pick a strong password. This is the only login for the admin table.
ADMIN_PASSWORD=change-this-to-a-strong-password
# Random secret used to sign the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-to-a-random-hex-string

# Notifications on "booked" (all optional; if unset, notifications are skipped gracefully)
# Email via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com
NOTIFY_EMAIL=you@yourdomain.com
# Optional confirmation email to the applicant (uses RESEND_API_KEY + RESEND_FROM_EMAIL)
SEND_APPLICANT_CONFIRMATION=false
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
NOTIFY_PHONE=+15557654321
